  "flow": {
    "triggers": [
      {
        "id": "device_refresh",
        "title": {
          "en": "Device dp refresh"
        },
        "tokens": [
          {
            "name": "rawJSON",
            "title": {
              "en": "Raw JSON data"
            },
            "type": "string",
            "example": "{\"dps\": { \"23\": 200 }}"
          }
        ],
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": {
              "driver_id": "bulb|panel|panel_rgb|tube_t8|bulb_g9|bulb_rgbw"
            }
          }
        ]
      },
      {
        "id": "sockets_changed",
        "title": {
          "en": "Sockets changed"
        },
        "tokens": [
          {
            "name": "state1",
            "title": {
              "en": "Socket 1"
            },
            "type": "boolean",
            "example": "true"
          },
          {
            "name": "state2",
            "title": {
              "en": "Socket 2"
            },
            "type": "boolean",
            "example": "true"
          },
          {
            "name": "state3",
            "title": {
              "en": "Socket 3"
            },
            "type": "boolean",
            "example": "true"
          }
        ],
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=power_strip"
          }
        ]
      }
    ],
    "conditions": [
      {
        "id": "socket_state",
        "title": {
          "en": "[[socket_number]] is turned !{{on|off}}"
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=power_strip"
          },
          {
            "name": "socket_number",
            "type": "dropdown",
            "title": {
              "en": "Socket"
            },
            "values": [
              {
                "id": "1",
                "title": {
                  "en": "Socket 1"
                }
              },
              {
                "id": "2",
                "title": {
                  "en": "Socket 2"
                }
              },
              {
                "id": "3",
                "title": {
                  "en": "Socket 3"
                }
              }
            ]
          }
        ]
      }
    ],
    "actions": [
      {
        "id": "set_socket",
        "title": {
          "en": "Set socket ..."
        },
        "titleFormatted": {
          "en": "Set [[socket_number]] to [[on_off]]"
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=power_strip"
          },
          {
            "name": "socket_number",
            "type": "dropdown",
            "title": {
              "en": "Socket"
            },
            "values": [
              {
                "id": "1",
                "title": {
                  "en": "Socket 1"
                }
              },
              {
                "id": "2",
                "title": {
                  "en": "Socket 2"
                }
              },
              {
                "id": "3",
                "title": {
                  "en": "Socket 3"
                }
              }
            ]
          },
          {
            "name": "on_off",
            "type": "dropdown",
            "title": {
              "en": "On/Off"
            },
            "values": [
              {
                "id": "true",
                "title": {
                  "en": "On"
                }
              },
              {
                "id": "false",
                "title": {
                  "en": "Off"
                }
              }
            ]
          }
        ]
      }
    ]
  },
